@page
@model ShopQA.Web.Pages.IndexModel

@{
    ViewData["Title"] = "ShopQA - Online Store";
}

<div class="container py-4">
    <header class="d-flex justify-content-between align-items-center mb-5">
        <h2 class="fw-bold">ShopQA</h2>
        <nav>
            <a href="/" class="text-decoration-none me-3">Home</a>
            <a href="/Cart" class="text-decoration-none">My Cart</a>
        </nav>
    </header>

    <section class="bg-light rounded-3 p-5 mb-5">
        <h1 class="display-5 fw-bold">Welcome to ShopQA</h1>
        <p class="lead">
            Discover quality products at great prices.
        </p>
        <a href="#products" class="btn btn-primary btn-lg">
            Browse Products
        </a>
    </section>

    <section id="products">
        <h2 class="mb-4">Our Products</h2>

        @if (Model.ErrorMessage != null)
        {
            <div class="alert alert-danger">
                @Model.ErrorMessage
            </div>
        }
        else if (Model.Products.Count == 0)
        {
            <div class="alert alert-info">
                No active products are available right now.
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var product in Model.Products)
                {
                    <div class="col-12 col-sm-6 col-lg-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title">
                                    @product.Name
                                </h5>

                                <p class="card-text text-secondary">
                                    @product.Description
                                </p>

                                <h4 class="text-primary">
                                    @product.Price.ToString("C2",
                                        System.Globalization.CultureInfo
                                            .GetCultureInfo("en-ZA"))
                                </h4>

                                @if (product.Stock > 0)
                                {
                                    <span class="badge bg-success">
                                        In stock: @product.Stock
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Out of stock
                                    </span>
                                }

                                <div class="mt-3">
                                    @if (product.Stock > 0)
                                    {
                                        <form method="post" asp-page-handler="AddToCart">
                                            <input type="hidden"
                                                   name="productId"
                                                   value="@product.Id" />

                                            <button type="submit" class="btn btn-primary w-100">
                                                Add to Cart
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary w-100" disabled>
                                            Out of Stock
                                        </button>
                                    }
                                </div>

                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>
