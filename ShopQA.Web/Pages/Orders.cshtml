
@page
@model ShopQA.Web.Pages.OrdersModel

@{
    ViewData["Title"] = "Orders";
    var culture = System.Globalization.CultureInfo.GetCultureInfo("en-ZA");
}

<div class="container py-5">
    <h1 class="mb-4">Your Orders</h1>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-warning">
            @Model.Message
        </div>
    }
    else if (Model.Orders.Count == 0)
    {
        <div class="alert alert-info">
            No orders found yet.
            <a asp-page="/Index">Continue shopping</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Total</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td>@order.Id</td>
                            <td>@order.OrderDate.ToLocalTime().ToString("g")</td>
                            <td>@order.Status</td>
                            <td>@order.Total.ToString("C2", culture)</td>
                            <td>
                                <a asp-page="/OrderDetails"
                                   asp-route-id="@order.Id"
                                   class="btn btn-sm btn-primary">
                                    View Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
